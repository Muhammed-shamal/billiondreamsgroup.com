---
import Layout from "../layouts/Layout.astro";

const ventures = [
  {
    title: "Billion Dreams Interiors",
    desc: "Complete commercial & residential interior fit-out, crafted with fully-equipped precision machinery. India and the UAE.",
    href: "/interiors",
    status: "active",
    statusText: "Active now",
    go: "Explore",
  },
  {
    title: "Indish eVolt",
    desc: "EV charging stations across India — designed, installed, operated and maintained end-to-end.",
    note: "In association with Indish World",
    href: "/indish-evolt",
    status: "active",
    statusText: "Rolling out",
    go: "Explore",
  },
  {
    title: "Billion Dreams Logistics",
    desc: "Moving goods with the same precision we bring to everything else.",
    href: "/logistics",
    status: "soon",
    statusText: "Coming soon",
    go: "In the works",
  },
  {
    title: "Billion Dreams Software Solutions",
    desc: "Custom software and digital products for growing businesses.",
    href: "/software-solutions",
    status: "soon",
    statusText: "Coming soon",
    go: "In the works",
  },
  // {
  //   title: "Billion Dreams Gym Equipments",
  //   desc: "Strength and performance equipment for gyms, studios and home setups.",
  //   href: "/gym-equipments",
  //   status: "soon",
  //   statusText: "Coming soon",
  //   go: "In the works",
  // },
];
---

<Layout title="Billion Dreams Group — One Group, Many Horizons">
  <section class="home-hero">
    <div class="container">
      <p class="kicker fade-up"><span></span>Billion Dreams Group<span></span></p>
      <h1 class="fade-up d1">One group.<br /><span class="accent">Many horizons.</span></h1>
      <p class="lede fade-up d2">
        A multi-sector group spanning interiors, electric mobility, logistics,
        software and gym equipments — united by craft, ambition and an eye for detail.
      </p>
      <div class="cta-row fade-up d3">
        <a href="/interiors" class="btn btn-accent">Explore Interiors →</a>
        <a href="#ventures" class="btn btn-ghost">Our ventures</a>
      </div>
      <ul class="hero-meta fade-up d3">
        <li>Five ventures</li>
        <li>UAE &amp; India</li>
        <li>Design · Mobility · Technology</li>
      </ul>
    </div>
    <a href="#ventures" class="scroll-cue" aria-label="Scroll to ventures">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
    </a>
  </section>

  <section class="section" id="ventures">
    <div class="container">
      <div class="center">
        <p class="eyebrow">Our ventures</p>
        <h2 class="section-title">Five pursuits, one standard of excellence</h2>
      </div>

      <div class="ventures" style="margin-top: 2.6rem;">
        {
          ventures.map((v) => {
            const isLink = v.status === "active";
            const Tag = isLink ? "a" : "div";
            return (
              <Tag class:list={["venture", isLink && "is-link"]} href={isLink ? v.href : undefined}>
                <span class:list={["status", v.status]}>{v.statusText}</span>
                <h3>{v.title}</h3>
                {v.note && <p class="venture-note">{v.note}</p>}
                <p>{v.desc}</p>
                <span class="go" style={isLink ? undefined : "color: var(--dim);"}>
                  {isLink ? `${v.go} →` : v.go}
                </span>
              </Tag>
            );
          })
        }
      </div>
    </div>
  </section>
</Layout>
