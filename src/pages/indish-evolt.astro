---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import evoltLogo from "../assets/brands/indish-evolt.png";
import heroImg from "../assets/evolt/hero.jpg";
import stationImg from "../assets/evolt/station-forecourt.jpg";
import plazaImg from "../assets/evolt/highway-plaza.jpg";
import energyImg from "../assets/evolt/clean-energy.jpg";
import chargingImg from "../assets/evolt/fast-charging.jpg";

const focus = [
  "EV Charging Infrastructure",
  "Renewable Energy",
  "Battery Technology",
  "Smart Electronics",
  "Electric Mobility",
];

const network = [
  {
    name: "Full-service infrastructure",
    body: "Every station is designed, installed, operated and maintained end-to-end — one company accountable for the whole thing.",
  },
  {
    name: "A range of charger capacities",
    body: "From 3.3 kW AC units up to 480 kW dual-gun DC fast chargers, matched to what each site actually needs.",
  },
  {
    name: "Flexible deployment",
    body: "Stations go in at partner locations: malls, highways, residential associations, corporate campuses and fleet depots.",
  },
  {
    name: "Partner-hosted sites",
    body: "Property owners host a station on their land; Indish eVolt handles the equipment, installation and day-to-day running.",
  },
  {
    name: "Transparent per-unit pricing",
    body: "Consistent, published charging rates across the network — no surprises at the screen.",
  },
];

// Station capabilities, as specified in the Indish eVolt product brief.
const capabilities = [
  "DC fast charging",
  "CCS2 connector",
  "Live charge % and range display",
  "Contactless / QR start",
  "24×7 support",
  "Renewable-linked energy",
  "Rest-area access",
  "Weatherproof outdoor design",
];

const segments = [
  "Individual EV owners",
  "Fleet operators",
  "Corporate campuses",
  "Malls & retail hubs",
  "Hotels & hospitality",
  "Highway rest stops",
  "Residential associations (RWAs)",
  "Government & public agencies",
];

const progress = [
  {
    n: "01",
    name: "Entity established",
    body: "Indish eVolt Pvt Ltd is incorporated and operating as a dedicated green-energy company under Indish World.",
  },
  {
    n: "02",
    name: "Charger line-up finalised",
    body: "The product range spans 3.3 kW AC through 480 kW dual-gun DC, with a 120 kW dual-gun tier added and a 180 kW next-generation model in R&D.",
  },
  {
    n: "03",
    name: "Phase 1 in planning",
    body: "The founding phase targets the first 200 charging machines, with the site and partner pipeline already active across malls, highways, RWAs and corporate campuses.",
  },
];

const renders = [
  { src: stationImg, alt: "Indish eVolt city forecourt station with three DC fast chargers under a branded canopy", cap: "City forecourt — concept" },
  { src: plazaImg, alt: "Indish eVolt highway plaza station with three charging bays and an adjacent rest area", cap: "Highway plaza — concept" },
  { src: chargingImg, alt: "An electric car connected to an Indish eVolt DC fast charger", cap: "DC fast charging — concept" },
  { src: energyImg, alt: "Indish eVolt charger with wind turbines and a city skyline behind it", cap: "Renewable-linked energy — concept" },
];
---

<Layout
  title="Indish eVolt — EV Charging Stations Across India"
  description="Indish eVolt designs, installs, operates and maintains EV charging infrastructure across India — from 3.3 kW AC units to 480 kW DC fast chargers. A partner venture presented by Billion Dreams Group."
  active="evolt"
  theme="theme-evolt"
>
  <!-- HERO -->
  <section class="page-hero page-hero--brand">
    <div class="hero-bg">
      <Image
        src={heroImg}
        alt="An Indish eVolt DC fast charging station"
        widths={[768, 1200, 1440]}
        sizes="100vw"
        quality={74}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container">
      <p class="eyebrow fade-up">Electric mobility</p>
      <h1 class="brand-h1 fade-up d1">
        <Image src={evoltLogo} alt="Indish eVolt" widths={[340, 680]} sizes="340px" />
      </h1>
      <p class="lede fade-up d2">
        EV charging stations across India — designed, installed, operated and
        maintained end-to-end, from highway plazas to city forecourts.
      </p>
      <div class="cta-row fade-up d3" style="margin-top: 1.6rem; display:flex; gap:0.8rem; flex-wrap:wrap;">
        <a href="https://www.indishevolt.com" class="btn btn-accent" target="_blank" rel="noopener">
          Visit indishevolt.com
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px;"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
        </a>
        <a href="#contact" class="btn btn-ghost">Get in touch</a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">About</p>
      <h2 class="section-title">An integrated green energy and electric mobility company</h2>
      <p class="section-lead">
        Indish eVolt designs, installs, operates and maintains EV charging
        infrastructure across India, with the wider goal of building a complete
        ecosystem for sustainable transportation, renewable energy and smart
        energy solutions.
      </p>

      <div class="note-strip">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 16v-4M12 8h.01"/></svg>
        <span>
          Indish eVolt Pvt Ltd is a green-energy company established under <strong>Indish World</strong>, a diversified enterprise building
          businesses since 1997 across aviation, communications, creations,
          manufacturing, information technology and commodity trading. It is
          presented here as a partner venture of Billion Dreams Group.
        </span>
      </div>

      <div class="chips">
        {
          focus.map((f) => (
            <span class="chip">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m13 2-9 12h7l-1 8 9-12h-7z"/></svg>
              {f}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- VISION & MISSION -->
  <section class="section" style="background:#050505; border-block:1px solid var(--line);">
    <div class="container">
      <p class="eyebrow">Vision &amp; mission</p>
      <h2 class="section-title">Where it's headed</h2>

      <div class="features">
        <div class="feature">
          <div class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <h3>Vision</h3>
          <p>
            To become one of India's leading integrated green energy and electric
            mobility companies, by building a complete ecosystem for sustainable
            transportation, renewable energy and smart energy solutions.
          </p>
        </div>
        <div class="feature">
          <div class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="0.5" fill="currentColor"/></svg>
          </div>
          <h3>Mission</h3>
          <p>
            To deliver innovative, reliable and sustainable energy solutions
            through EV charging infrastructure, renewable energy, battery
            technology, smart electronics and electric mobility.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- NETWORK -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">Our solution</p>
      <h2 class="section-title">The Indish eVolt charging network</h2>
      <p class="section-lead">
        One operator, accountable end-to-end — from choosing the site and sizing
        the hardware to keeping every gun working on a wet Tuesday night.
      </p>

      <div class="features features--tri">
        {
          network.map((n) => (
            <div class="feature">
              <div class="ic">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m13 2-9 12h7l-1 8 9-12h-7z"/></svg>
              </div>
              <h3>{n.name}</h3>
              <p>{n.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- STATIONS -->
  <section class="section" id="stations" style="background:#050505; border-top:1px solid var(--line);">
    <div class="container">
      <p class="eyebrow">The stations</p>
      <h2 class="section-title">Built for the road</h2>
      <p class="section-lead">
        Indish eVolt stations are designed to be fast, reliable and easy to use,
        from highway plazas to city forecourts. Every station carries the same
        core experience: real-time charge status, contactless start and
        round-the-clock support.
      </p>

      <div class="chips">
        {
          capabilities.map((c) => (
            <span class="chip">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
              {c}
            </span>
          ))
        }
      </div>

      <div class="gallery">
        {
          renders.map((r) => (
            <figure>
              <Image
                src={r.src}
                alt={r.alt}
                widths={[300, 600, 900]}
                sizes="(max-width: 600px) 90vw, (max-width: 1000px) 45vw, 30vw"
                quality={72}
              />
              <figcaption>{r.cap}</figcaption>
            </figure>
          ))
        }
      </div>
      <p class="section-lead" style="margin-top:1.2rem; font-size:0.82rem; color:var(--dim);">
        Images are design visualisations of the Indish eVolt station format, not
        photographs of installed sites.
      </p>
    </div>
  </section>

  <!-- SEGMENTS -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">Who we serve</p>
      <h2 class="section-title">Target customers and segments</h2>

      <div class="segments">
        {
          segments.map((s) => (
            <div class="segment">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
              {s}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PROGRESS -->
  <section class="section" style="background:#050505; border-block:1px solid var(--line);">
    <div class="container">
      <p class="eyebrow">Where things stand</p>
      <h2 class="section-title">Building the founding phase</h2>
      <p class="section-lead">
        Indish eVolt is in its rollout phase — the company, the product line and
        the partner framework are in place, and the first sites are being lined up.
      </p>

      <div class="features">
        {
          progress.map((p) => (
            <div class="feature">
              <div class="ic">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M3 12l9 4 9-4"/><path d="M3 17l9 4 9-4"/></svg>
              </div>
              <h3><span style="color:var(--accent-2); font-weight:800; margin-right:.4rem;">{p.n}</span>{p.name}</h3>
              <p>{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section" id="contact">
    <div class="container">
      <p class="eyebrow">Get in touch</p>
      <h2 class="section-title">Talk to Indish eVolt</h2>
      <p class="section-lead">
        Hosting a station, charging a fleet, or just want to know when a site
        opens near you — the Indish eVolt team will take it from here.
      </p>

      <div class="contact-grid">
        <div class="location">
          <div class="loc-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3>Calicut office</h3>
          <p class="region">Kerala, India</p>
          <div class="row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>3rd Floor, Coxwain 23, Beach Road, Calicut 673032</span>
          </div>
          <div class="row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2z"/></svg>
            <a href="tel:+919995555044">+91 999 555 5044</a>
          </div>
        </div>

        <div class="location">
          <div class="loc-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3>Cochin office</h3>
          <p class="region">Kerala, India</p>
          <div class="row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>12-A CIASL Business Centre, Cochin International Airport 683111</span>
          </div>
          <div class="row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2z"/></svg>
            <a href="tel:+917907116895">+91 79 07 11 68 95</a>
          </div>
        </div>

        <div class="location">
          <div class="loc-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
          </div>
          <h3>Email &amp; UAE</h3>
          <p class="region">Enquiries welcome</p>
          <div class="row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
            <a href="mailto:business@indishevolt.com">business@indishevolt.com</a>
          </div>
          <div class="row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2z"/></svg>
            <a href="tel:+971563600927">+971 56 360 0927 · UAE</a>
          </div>
          <div style="margin-top:1.2rem;">
            <a href="https://www.indishevolt.com" class="btn btn-accent" target="_blank" rel="noopener">
              indishevolt.com
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px;"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
