---
import { Image } from "astro:assets";
import logo from "../assets/logo.jpeg";

interface Props {
  active?: string;
}
const { active } = Astro.props;

const links = [
  { href: "/interiors", label: "Interiors & Landscapes", key: "interiors" },
  { href: "/perfumes", label: "Perfumes", key: "perfumes", soon: true },
  { href: "/ventures", label: "Venture Capital", key: "ventures", soon: true },
  { href: "/fitness", label: "Fitness", key: "fitness", soon: true },
];
---

<header class="site-header">
  <div class="container">
    <a href="/" class="brand-link" aria-label="Billion Dreams Group — home">
      <Image src={logo} alt="Billion Dreams" class="logo" width={220} height={147} />
    </a>
    <nav class="nav" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            class={active === l.key ? "is-active" : ""}
            aria-current={active === l.key ? "page" : undefined}
          >
            {l.label}
            {l.soon && <span class="soon">soon</span>}
          </a>
        ))
      }
    </nav>
  </div>
</header>
