---
interface Props {
  title: string;
  tagline: string;
  statusText?: string;
  statusKind?: "soon" | "future";
}
const { title, tagline, statusText = "Coming soon", statusKind = "soon" } =
  Astro.props;
---

<section class="coming">
  <span class:list={["status", statusKind]}>{statusText}</span>
  <p class="eyebrow">Billion Dreams</p>
  <h1 class="accent fade-up">{title}</h1>
  <p class="fade-up d1">{tagline}</p>
  <a href="/" class="btn btn-ghost fade-up d2">← Back to Billion Dreams Group</a>
</section>
