---
import { Image } from "astro:assets";
import logo from "../assets/brands/billion-dreams.png";
import wiesella from "../assets/brands/wiesella.png";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <Image src={logo} alt="Billion Dreams" width={200} />
        <p>
          One group, many horizons — spanning interiors, electric mobility,
          logistics, software and gym equipments.
        </p>
      </div>

      <div class="footer-col">
        <h4>Ventures</h4>
        <a href="/interiors">Billion Dreams Interiors</a>
        <a href="/indish-evolt">Indish eVolt</a>
        <a href="/logistics">Billion Dreams Logistics</a>
        <a href="/software-solutions">Software Solutions</a>
        <!-- <a href="/gym-equipments">Gym Equipments</a> -->
      </div>

      <div class="footer-col">
        <h4>Interiors Contact</h4>
        <a href="tel:+971563600927">+971 56 360 0927 · UAE</a>
        <a href="tel:+919995555044">+91 99955 55044 · India</a>
        <a href="mailto:interiors@billiondreamsgroup.com">interiors@billiondreamsgroup.com</a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} Billion Dreams Group. All rights reserved.</span>
      <span>Dubai · Sharjah · Ras Al Khaimah · Calicut</span>
    </div>

    <a
      class="built-by"
      href="https://wiesella.com"
      target="_blank"
      rel="noopener"
      aria-label="Designed and developed by Wiesella — opens wiesella.com in a new tab"
    >
      <span class="built-by-label">Designed &amp; developed by</span>
      <Image src={wiesella} alt="Wiesella — Digital Marketing and Software Solutions" widths={[160, 320]} sizes="160px" />
    </a>
  </div>
</footer>
